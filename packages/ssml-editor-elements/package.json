  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "monaco-editor": "^0.56.0"
  },
  "dependencies": {
    "@ssml-builder-js/ssml-core": "^2.5.0"
  }
