{
  "name": "@ssml-builder-js/ssml-editor-elements",
  "version": "2.5.0",
  "description": "Framework-independent SSML editor custom element",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/SSML-Builder.git",
    "directory": "packages/ssml-editor-elements"
  },
  "bugs": {
    "url": "https://github.com/nitta-a/SSML-Builder/issues"
  },
  "homepage": "https://github.com/nitta-a/SSML-Builder#ssml-editor-elements",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
