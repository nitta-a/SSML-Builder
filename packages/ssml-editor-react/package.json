{
  "name": "@ssml-builder/ssml-editor-react",
  "version": "0.1.0",
  "description": "React-based SSML editor component",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@ssml-builder/ssml-core": "workspace:*"
  }
}
