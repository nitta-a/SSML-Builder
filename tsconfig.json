{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true
  },
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "packages/ssml-core" },
    { "path": "packages/ssml-editor-react" },
    { "path": "packages/azure-tts-client" }
  ]
}
