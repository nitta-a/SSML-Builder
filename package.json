{
  "name": "ssml-builder-js",
  "version": "2.1.0",
  "description": "SSML building utilities, a React editor, and an Azure Text-to-Speech client",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "npm run build --workspaces --if-present",
    "build": "tsup",
    "check": "biome check .",
    "changeset": "changeset",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome check .",
    "release": "npm run build && changeset publish",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version-packages": "changeset version && node scripts/sync-root-version.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@types/node": "^24.0.0",
    "tsup": "8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "microsoft-cognitiveservices-speech-sdk": "1.51.0"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "esbuild": "0.28.2",
    "monaco-editor": {
      "dompurify": "3.4.13"
    }
  }
}
