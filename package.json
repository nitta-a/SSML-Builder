{
  "name": "ssml-builder",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "biome check .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "tsup": "8.5.1",
    "typescript": "^7.0.2"
  }
}
